// ===============================
// Circulation Ledger
// ===============================

class CirculationLedger {

    static String branchCode;

    static {

        branchCode = "PT-BRANCH";
    }

    static String processNightlyCirculation(
            LoanReceipt[] receipts) {

        int processed = 0;
        int skipped = 0;
        int reference = 0;
        int regular = 0;

        for (LoanReceipt receipt : receipts) {

            if (receipt == null) {

                skipped++;
                continue;
            }

            processed++;

            if (receipt instanceof ReferenceOnlyLoanReceipt)
                reference++;
            else
                regular++;
        }

        return processed +
               " processed | " +
               skipped +
               " null skipped | " +
               reference +
               " reference-only | " +
               regular +
               " regular";
    }
}


