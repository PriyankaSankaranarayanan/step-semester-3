    // ================= QUESTION 3 =================
    // Campus Premiere Ticket Counter

    static abstract class Seat {
        String id;
        Seat(String id) { this.id = id; }
        abstract double getPrice();
    }

    static class Regular extends Seat {
        Regular(String id) { super(id); }
        double getPrice() { return 150; }
    }

    static class Premium extends Seat {
        Premium(String id) { super(id); }
        double getPrice() { return 250; }
    }

    static class Recliner extends Seat {
        Recliner(String id) { super(id); }
        double getPrice() { return 400; }
    }

    static class Show {
        String time;
        Map<String, Booking> booked = new HashMap<>();
        Show(String time) { this.time = time; }
    }

    static class Booking {
        String customer;
        Show show;
        List<Seat> seats;
        boolean cancelled = false;

        Booking(String c, Show s, List<Seat> seats) {
            customer = c;
            show = s;
            this.seats = new ArrayList<>(seats);
        }

        double total() {
            double sum = 0;
            for (Seat s : seats) sum += s.getPrice();
            return sum;
        }

        void cancel(boolean showStarted) {
            if (cancelled) {
                System.out.println("Booking already cancelled.");
                return;
            }
            if (showStarted) {
                System.out.println("Cannot cancel after show starts.");
                return;
            }

            for (Seat s : seats) show.booked.remove(s.id);
            cancelled = true;
            System.out.println(customer + "'s booking cancelled. Seats " +
                    seatNames(seats) + " released.");
        }
    }

    static String seatNames(List<Seat> seats) {
        List<String> names = new ArrayList<>();
        for (Seat s : seats) names.add(s.id);
        return String.join(", ", names);
    }

    static Booking book(String customer, Show show, Seat... seats) {
        if (seats.length < 1 || seats.length > 6) {
            System.out.println("Booking must contain 1 to 6 seats.");
            return null;
        }

        Set<String> ids = new HashSet<>();
        for (Seat s : seats) {
            if (!ids.add(s.id)) {
                System.out.println("Duplicate seat in booking: " + s.id);
                return null;
            }
            if (show.booked.containsKey(s.id)) {
                System.out.println("Seat " + s.id +
                        " is already booked for this show.");
                return null;
            }
        }

        Booking b = new Booking(customer, show, Arrays.asList(seats));
        for (Seat s : seats) show.booked.put(s.id, b);

        System.out.printf("Booking confirmed for %s: %s. Total: ₹%.2f.%n",
                customer, seatNames(b.seats), b.total());
        return b;
    }

    static void question3() {
        System.out.println("\n--- QUESTION 3: TICKETS ---");

        Show show = new Show("7 PM");

        Booking asha = book("Asha", show,
                new Regular("A1"), new Regular("A2"),
                new Premium("F5"));

        book("Ravi", show, new Regular("A2"));
        book("Ravi", show, new Recliner("R1"));

        if (asha != null) asha.cancel(false);

        book("Neha", show, new Regular("A2"));
    }

    // ================= QUESTION 4 =================
    // FitZone Membership Desk

    interface MembershipPlan {
        int months();
        double discount();
        String name();

        default double calculateFee() {
            return 1000.0 * months() * (1 - discount());
        }
    }

    static class Monthly implements MembershipPlan {
        public int months() { return 1; }
        public double discount() { return 0; }
        public String name() { return "Monthly"; }
    }

    static class Quarterly implements MembershipPlan {
        public int months() { return 3; }
        public double discount() { return 0.10; }
        public String name() { return "Quarterly"; }
    }

    static class Annual implements MembershipPlan {
        public int months() { return 12; }
        public double discount() { return 0.25; }
        public String name() { return "Annual"; }
    }

    static class Membership {
        String member;
        MembershipPlan plan;
        private String status = "Active";

        Membership(String member, MembershipPlan plan) {
            this.member = member;
            this.plan = plan;
            System.out.printf("%s membership created for %s. Fee: ₹%.2f. Status: %s.%n",
                    plan.name(), member, plan.calculateFee(), status);
        }

        void checkIn() {
            if (status.equals("Active"))
                System.out.println(member + " checked in successfully.");
            else
                System.out.println("Check-in denied: " + member +
                        "'s membership is " + status + ".");
        }

        void freeze() {
            if (!status.equals("Active")) {
                System.out.println("Cannot freeze a " + status + " membership.");
                return;
            }
            status = "Frozen";
            System.out.println(member + "'s membership frozen. Status: " + status + ".");
        }

        void unfreeze() {
            if (!status.equals("Frozen")) {
                System.out.println("Cannot unfreeze a " + status + " membership.");
                return;
            }
            status = "Active";
            System.out.println(member + "'s membership unfrozen. Status: " + status + ".");
        }

        void expire() {
            if (status.equals("Expired")) return;
            status = "Expired";
            System.out.println(member + "'s membership expired. Status: " + status + ".");
        }
    }

    static void question4() {
        System.out.println("\n--- QUESTION 4: GYM ---");

        Membership asha = new Membership("Asha", new Quarterly());
        Membership ravi = new Membership("Ravi", new Monthly());

        asha.checkIn();
        asha.freeze();
        asha.checkIn();

        ravi.expire();
        ravi.freeze();
    }

    // ================= QUESTION 5 =================
    // Campus Notice Broadcaster

    interface NotificationChannel {
        void send(String student, String title);
    }

    static class EmailChannel implements NotificationChannel {
        public void send(String student, String title) {
            System.out.println("[Email → " + student + "] " + title);
        }
    }

    static class SmsChannel implements NotificationChannel {
        public void send(String student, String title) {
            System.out.println("[SMS → " + student + "] " + title);
        }
    }

    static class AppChannel implements NotificationChannel {
        public void send(String student, String title) {
            System.out.println("[App → " + student + "] " + title);
        }
    }

    static class NoticeStudent {
        String name, department;
        List<NotificationChannel> channels = new ArrayList<>();

        NoticeStudent(String n, String d) {
            name = n;
            department = d;
        }

        void addChannel(NotificationChannel c) {
            channels.add(c);
        }
    }

    static class Notice {
        String title;
        Set<String> departments;

        Notice(String title, String... departments) {
            this.title = title;
            this.departments = new HashSet<>(Arrays.asList(departments));
        }

        boolean isValid() {
            return title != null && !title.trim().isEmpty()
                    && !departments.isEmpty()
                    && !departments.contains("");
        }
    }

    static class NoticeBoard {
        List<NoticeStudent> students = new ArrayList<>();

        void addStudent(NoticeStudent s) {
            students.add(s);
        }

        void post(Notice n) {
            if (!n.isValid()) {
                System.out.println("Cannot post notice: At least one target department is required.");
                return;
            }

            System.out.println("Notice '" + n.title +
                    "' posted to " + String.join(", ", n.departments) + ".");

            for (NoticeStudent s : students) {
                if (n.departments.contains(s.department)) {
                    for (NotificationChannel c : s.channels)
                        c.send(s.name, n.title);
                }
            }
        }
    }

    static void question5() {
        System.out.println("\n--- QUESTION 5: NOTICES ---");

        NoticeBoard board = new NoticeBoard();

        NoticeStudent asha = new NoticeStudent("Asha", "CSE");
        asha.addChannel(new EmailChannel());
        asha.addChannel(new AppChannel());

        NoticeStudent ravi = new NoticeStudent("Ravi", "ECE");
        ravi.addChannel(new SmsChannel());

        board.addStudent(asha);
        board.addStudent(ravi);

        board.post(new Notice("Lab Closed Tomorrow", "CSE"));
        board.post(new Notice("Fee Deadline Extended", "CSE", "ECE"));
        board.post(new Notice("Sports Day"));
    }

