    // ================= QUESTION 1 =================
    // Hostel Laundry Queue

    interface WashType {
        int duration();
        double charge();
        String name();
    }

    static class Quick implements WashType {
        public int duration() { return 30; }
        public double charge() { return 20; }
        public String name() { return "Quick"; }
    }

    static class Normal implements WashType {
        public int duration() { return 45; }
        public double charge() { return 30; }
        public String name() { return "Normal"; }
    }

    static class Heavy implements WashType {
        public int duration() { return 60; }
        public double charge() { return 45; }
        public String name() { return "Heavy"; }
    }

    static class Student {
        String name;
        Student(String name) { this.name = name; }
    }

    static class WashCycle {
        Student student;
        WashingMachine machine;
        WashType type;

        WashCycle(Student s, WashingMachine m, WashType t) {
            student = s;
            machine = m;
            type = t;
        }
    }

    static class WashingMachine {
        String id;
        private WashCycle cycle;

        WashingMachine(String id) { this.id = id; }

        void start(Student s, WashType t) {
            if (cycle != null) {
                System.out.println("Machine " + id + " is currently busy.");
                return;
            }
            cycle = new WashCycle(s, this, t);
            System.out.printf("%s wash started on %s for %s (%d min). Charge: ₹%.2f.%n",
                    t.name(), id, s.name, t.duration(), t.charge());
        }

        void complete() {
            if (cycle == null) {
                System.out.println(id + " is already free.");
                return;
            }
            System.out.println(id + " cycle completed.");
            cycle = null;
            System.out.println(id + " is now free.");
        }
    }

    static void question1() {
        System.out.println("\n--- QUESTION 1: LAUNDRY ---");
        Student asha = new Student("Asha");
        Student ravi = new Student("Ravi");
        Student neha = new Student("Neha");

        WashingMachine m1 = new WashingMachine("M1");
        WashingMachine m2 = new WashingMachine("M2");

        m1.start(asha, new Quick());
        m1.start(ravi, new Heavy());
        m2.start(ravi, new Heavy());
        m1.complete();
        m1.start(neha, new Normal());
    }

    // ================= QUESTION 2 =================
    // Assignment Submission Portal

    static abstract class Assignment {
        String title;
        int maxMarks;
        LocalDate dueDate;

        Assignment(String title, int max, LocalDate due) {
            this.title = title;
            maxMarks = max;
            dueDate = due;
        }

        abstract double penaltyPerDay();
    }

    static class CodingAssignment extends Assignment {
        CodingAssignment(String t, int m, LocalDate d) {
            super(t, m, d);
        }
        double penaltyPerDay() { return 0.10; }
    }

    static class WrittenAssignment extends Assignment {
        WrittenAssignment(String t, int m, LocalDate d) {
            super(t, m, d);
        }
        double penaltyPerDay() { return 0.20; }
    }

    static class Submission {
        String student;
        Assignment assignment;
        LocalDate submittedDate;
        private String status = "Submitted";

        Submission(String s, Assignment a, LocalDate date) {
            student = s;
            assignment = a;
            submittedDate = date;
        }

        void grade(int marks) {
            if (!status.equals("Submitted")) {
                System.out.println("Cannot grade: already graded.");
                return;
            }
            if (marks < 0 || marks > assignment.maxMarks) {
                System.out.println("Invalid marks.");
                return;
            }

            long days = Math.max(0,
                    ChronoUnit.DAYS.between(
                            assignment.dueDate, submittedDate));

            double finalMarks = marks *
                    (1 - days * assignment.penaltyPerDay());

            finalMarks = Math.max(0, finalMarks);
            status = "Graded";

            System.out.printf("%s graded: %.0f/%d",
                    student, finalMarks, assignment.maxMarks);

            if (days > 0)
                System.out.printf(" after %.0f%% late penalty",
                        days * assignment.penaltyPerDay() * 100);

            System.out.println(". Status: " + status + ".");
        }

        void resubmit() {
            if (status.equals("Graded"))
                System.out.println("Cannot resubmit: '" +
                        assignment.title + "' has already been graded.");
            else
                System.out.println("Resubmission allowed.");
        }
    }

